{
  "version": 2,
  "buildCommand": "vite build && node scripts/generate-static.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.gomoroccoai.com"
        }
      ],
      "destination": "https://gomoroccoai.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/city.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>.*)"
        }
      ],
      "destination": "/city/$id.html"
    },
    {
      "source": "/blog.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>.*)"
        }
      ],
      "destination": "/blog/$id.html"
    }
  ]
}
